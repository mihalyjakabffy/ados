    "asset.logo.concept": {
      "constraint": "",
      "source": "visual_identity.logo.concept",
      "unit": "string",
      "value": "OM is read as a pair, not as a word: O is the opening, M is the mass. Architecture is the negotiation between what is cut away and what is left standing, and in an existing building that negotiation is the whole job. The mark is a square aperture \u2014 a threshold seen in plan \u2014 constructed on the same module the sheets are set on. It is a fragment of a drawing rather than a picture of a building."
    },
    "asset.logo.field": {
      "constraint": "",
      "source": "logo.construction.field_modules \u00d7 module",
      "unit": "mm",
      "value": 30.0
    },
    "asset.logo.gap": {
