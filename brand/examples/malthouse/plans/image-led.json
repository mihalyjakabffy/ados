      "slots": [
        {
          "component": "section-label",
          "block": "",
          "text": "INTERVENTION",
          "label": "",
          "provenance": "",
          "path": "",
          "rank": "label",
          "step": "t2",
          "cap_mm": 2.5,
          "emphasis": false,
          "x_mm": 0.0,
          "y_mm": 0.0,
          "width_mm": 38.75,
          "height_mm": 10.0,
          "columns": 1,
          "ink": 0.18
        },
        {
          "component": "body",
          "block": "nar-04",
          "text": "The roof is rebuilt to the original profile in glue-laminated timber, with a continuous rooflight along the ridge where the kiln vents were. The new frame is left exposed and unpainted, so that what is new is legible as new at a glance and no one has to consult a drawing to read the building.",
          "label": "",
          "provenance": "",
          "path": "",
          "rank": "body",
          "step": "t2",
          "cap_mm": 2.5,
          "emphasis": false,
          "x_mm": 43.75,
          "y_mm": 0.0,
          "width_mm": 126.25,
          "height_mm": 25.0,
          "columns": 3,
          "ink": 0.18
        },
        {
          "component": "body",
          "block": "fct-01",
          "text": "Adaptive reuse, structure left legible",
          "label": "Character",
          "provenance": "",
          "path": "",
          "rank": "body",
          "step": "t2",
          "cap_mm": 2.5,
          "emphasis": false,
          "x_mm": 43.75,
          "y_mm": 30.0,
          "width_mm": 126.25,
          "height_mm": 20.0,
          "columns": 3,
          "ink": 0.18
        },
        {
          "component": "body",
          "block": "fct-02",
          "text": "Quiet, north-lit, material",
          "label": "Atmosphere",
          "provenance": "",
          "path": "",
          "rank": "body",
          "step": "t2",
          "cap_mm": 2.5,
          "emphasis": false,
          "x_mm": 43.75,
          "y_mm": 55.0,
          "width_mm": 126.25,
          "height_mm": 20.0,
          "columns": 3,
          "ink": 0.18
        },
        {
          "component": "body",
          "block": "nar-05",
          "text": "The building reopened as a workshop and exhibition space with a public route through the full depth of the plan. Measured energy use in the first full year came in below the design estimate, and the retained structure avoided the embodied carbon of a replacement frame.",
          "label": "",
          "provenance": "",
          "path": "",
          "rank": "body",
          "step": "t2",
          "cap_mm": 2.5,
          "emphasis": false,
          "x_mm": 43.75,
          "y_mm": 80.0,
          "width_mm": 126.25,
          "height_mm": 20.0,
          "columns": 3,
          "ink": 0.18
        },
        {
          "component": "figure",
          "block": "img-03",
          "text": "The same bay with the new frame and rooflight.",
          "label": "",
          "provenance": "",
          "path": "projects/malthouse/03-interior-after.jpg",
          "rank": "caption",
          "step": "t1",
          "cap_mm": 1.8,
