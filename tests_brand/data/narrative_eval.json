{
  "dataset_version": "3.3.0",
  "description": "ADOS-M3.3 §41/§42 evaluation dataset. Each case names real sources (project metadata, raw document text), a SemanticIntent, and a document type, and states what a correct narrative plan must and must not do: which strategy shape it should realise, which real content ids it may reference, what must be surfaced (missing/conflicting information), and what must never appear (an unsupported fact).",
  "cases": [
    {
      "id": "case_a_portfolio_concept_driven",
      "note": "ADOS-M3.3 §41 Case A -- concept-driven strategy.",
      "project_data": {"program": "residential", "location": "Budapest"},
      "raw_documents": [
        {"source_id": "brief", "text": "84 apartments. GFA of 13,100 m². The project creates a strong connection to the landscape."}
      ],
      "semantic_intent": {"explicit": {"audience": "prospective_client", "purpose": "introduce_project"}},
      "document_type_id": "portfolio",
      "expected_strategy_contains": ["concept", "development"],
      "forbidden_fact_keys": ["client", "architect", "structure", "completion_year", "budget"],
      "expect_validation_ok": true
    },
    {
      "id": "case_b_client_presentation_problem_solution_value",
      "note": "ADOS-M3.3 §41 Case B -- same project, problem -> solution -> value.",
