      "document_type_id": "competition-document",
      "expected_strategy_contains": ["question", "concept", "strategy", "evidence", "result"],
      "forbidden_fact_keys": ["client", "architect", "structure", "completion_year", "budget"],
      "expect_validation_ok": true
    },
