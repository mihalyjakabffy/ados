{
  "dataset_version": "3.1.0",
  "description": "ADOS-M3.1 §18 evaluation dataset. Each case names a request, the real context (if any) it should be interpreted with, the intent a correct system should produce, fields where more than one answer is acceptable, and values that must never appear (a hallucination, or specificity the request does not support).",
  "cases": [
    {
      "id": "create_portfolio_riverside",
      "note": "ADOS-M3.1 §14's own worked example.",
      "input": "Create a portfolio about the Riverside project. Make it feel like our existing studio materials but more premium.",
      "context": {},
      "expected_intent": {
        "action": "create",
        "target": "document",
        "document_type": "portfolio",
        "subject": "Riverside project",
        "style_reference": "existing studio materials",
        "quality_direction": "premium"
      },
      "acceptable_variants": {},
      "forbidden_inferences": ["page_count", "font", "grid", "color", "colour", "image_count", "layout"],
      "expect_validation_ok": true
    },
    {
      "id": "transform_for_client_no_context",
      "note": "ADOS-M3.1 §15's own worked example, no document open.",
      "input": "Turn this into something I can send to the client.",
      "context": {},
      "expected_intent": {
        "action": "transform",
        "audience": "client"
      },
      "acceptable_variants": {
        "target": ["ambiguous"]
      },
      "forbidden_inferences": ["document_type=presentation", "document_type=report"],
      "expect_validation_ok": true
    },
    {
      "id": "transform_for_client_with_open_document",
      "note": "Same request, real context this time — ADOS-M3.1 §17's context-sensitivity requirement.",
      "input": "Turn this into something I can send to the client.",
      "context": {"has_open_document": true},
      "expected_intent": {
        "action": "transform",
        "audience": "client",
        "target": "document"
      },
      "acceptable_variants": {},
      "forbidden_inferences": ["document_type=presentation"],
      "expect_validation_ok": true
    },
    {
      "id": "same_branding_more_visual",
      "note": "ADOS-M3.1 §16's own worked example.",
      "input": "Use the same branding as the last presentation but make this one much more visual.",
      "context": {},
      "expected_intent": {
        "style_reference": "previous presentation",
        "brand_reference": "previous presentation",
        "design_direction": "more visual"
      },
      "acceptable_variants": {
        "action": ["ambiguous"],
        "style_reference": ["previous presentation", "last presentation"],
        "brand_reference": ["previous presentation", "last presentation"]
      },
      "forbidden_inferences": ["image_ratio", "grid", "numeric layout value"],
      "expect_validation_ok": true
